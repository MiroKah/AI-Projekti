# =============================================================================
# StudyAI Backend — ympäristömuuttujat
# Kopioi tämä tiedostoksi .env ja täytä arvot.
# =============================================================================

# --- Sovellus ---
APP_NAME=StudyAI
APP_ENV=development
DEBUG=true
API_PREFIX=/api

# --- CORS (frontendin osoite) ---
CORS_ORIGINS=http://localhost:3000

# --- Tietokanta (Docker-verkossa "db", paikallisesti "localhost") ---
DATABASE_URL=postgresql+asyncpg://studyai:studyai@db:5432/studyai

# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536

# --- RAG-parametrit ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5

# --- Tiedostojen lataus ---
MAX_UPLOAD_SIZE_MB=25
UPLOAD_DIR=./data/uploads