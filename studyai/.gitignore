.env.local
.env.*.local

# Node / Next.js
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Docker
*.log

# Editorit / käyttöjärjestelmä
.vscode/
.idea/
.DS_Store
Thumbs.db